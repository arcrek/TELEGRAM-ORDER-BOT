# syntax=docker/dockerfile:1
#
# Multistage build for the Pay2S IPN server (Flask).

ARG PYTHON_VERSION=3.11-slim

########################
# Builder
########################
FROM python:${PYTHON_VERSION} AS builder

ENV PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt ./
RUN pip install --prefix=/install -r requirements.txt

########################
# Runtime
########################
FROM python:${PYTHON_VERSION}

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

COPY --from=builder /install /usr/local
COPY src ./src
COPY config ./config
COPY run_ipn_server.py ./run_ipn_server.py
COPY wsgi.py ./wsgi.py

RUN useradd -m appuser
USER appuser

EXPOSE 5001

# Default IPN config (override via env in compose)
ENV IPN_HOST=0.0.0.0 \
    IPN_PORT=5001

# For development you could run run_ipn_server.py; for production, use gunicorn wsgi:app
CMD ["gunicorn", "--bind", "0.0.0.0:5001", "--workers", "4", "--threads", "2", "--timeout", "30", "--access-logfile", "-", "--error-logfile", "-", "wsgi:app"]


