SYSTEM_NAME=YOUR_SYSTEM_NAME

# Telegram Bot
TELEGRAM_BOT_TOKEN=          # Customer bot token
SUPPLIER_TELEGRAM_BOT_TOKEN= # Supplier bot token

# Database (PostgreSQL only — SQLite not supported in production)
APP_ENV=dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mtkbot
DB_USER=mtkbot
DB_PASSWORD=changeme

GLOBAL_ADMIN_ID=

# PayOS payment gateway
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Dashboard API
DASHBOARD_SECRET_KEY=          # JWT signing key (generate a strong random secret)
DASHBOARD_PORT=8001
CORS_ORIGINS=http://localhost:5173,http://localhost:3000   # Comma-separated, no wildcards

VITE_API_BASE_URL=http://localhost:8001

# Bot support contact lines (displayed in bot messages)
SUPPORT_LINE_1=
SUPPORT_LINE_2=

# App timezone — IANA name for the global bot timezone (default: Asia/Ho_Chi_Minh)
# Controls all time displays in the customer Telegram bot.
# The dashboard always uses the browser's local timezone.
# Can be updated at runtime via the dashboard at /api/app-settings.
APP_TIMEZONE=Asia/Ho_Chi_Minh
